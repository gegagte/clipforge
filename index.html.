
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#080711">
<title>CLIPFORGE — Creator Pro</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root{
--bg:#080711;--panel:#100f1c;--panel2:#171527;--line:#29243e;
--purple:#a78bfa;--pink:#e879f9;--muted:#918ba9;
--white:#f7f4ff;--green:#65e6b3;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--white);font-family:'DM Sans',sans-serif;min-height:100vh}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.app{display:flex;min-height:100vh}
.sidebar{
width:245px;position:fixed;inset:0 auto 0 0;z-index:5;
background:#0c0b16;border-right:1px solid var(--line);
padding:25px 17px;display:flex;flex-direction:column
}
.logo{font:800 24px 'Space Grotesk';letter-spacing:-1px}
.logo span{color:var(--purple)}
.logo-mark{display:inline-grid;place-items:center;width:29px;height:29px;
background:linear-gradient(135deg,#8b5cf6,#e879f9);border-radius:9px;margin-right:8px}
.tagline{font-size:9px;letter-spacing:2px;color:var(--muted);margin:9px 0 37px}
.nav-label{font-size:9px;font-weight:800;letter-spacing:1.7px;color:#6f6985;margin:19px 10px 9px}
.nav{width:100%;border:1px solid transparent;background:none;color:var(--muted);
text-align:left;padding:12px;border-radius:11px;margin:3px 0;font-size:12px;
display:flex;align-items:center;gap:12px;transition:.2s}
.nav:hover,.nav.active{background:#1d1930;color:white;border-color:#373052}
.nav.active{box-shadow:inset 3px 0 var(--purple)}
.nav-icon{font-size:16px;width:19px;text-align:center}
.sidebar-bottom{margin-top:auto;border:1px solid var(--line);background:var(--panel);
padding:14px;border-radius:13px}
.status{display:flex;align-items:center;gap:7px;font-size:10px;color:var(--green)}
.dot{width:7px;height:7px;background:var(--green);border-radius:50%;box-shadow:0 0 9px var(--green)}
.sidebar-bottom p{font-size:10px;color:var(--muted);line-height:1.6}
.main{margin-left:245px;width:calc(100% - 245px);padding:30px 38px 55px}
.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:29px}
.eyebrow{font-size:9px;letter-spacing:2px;color:var(--purple);font-weight:800}
h1{font:700 29px 'Space Grotesk';letter-spacing:-1px;margin:7px 0}
.subtitle{font-size:12px;color:var(--muted)}
.profile{width:39px;height:39px;border-radius:12px;background:linear-gradient(135deg,#8b5cf6,#e879f9);
display:grid;place-items:center;font-weight:800}
.page{display:none}.page.active{display:block}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-bottom:18px}
.card{background:linear-gradient(145deg,#141225,#0e0d19);border:1px solid var(--line);
border-radius:16px;padding:18px;box-shadow:0 10px 40px #0002}
.stat-label{font-size:9px;color:var(--muted);letter-spacing:1px;font-weight:700}
.stat-value{font:700 25px 'Space Grotesk';margin:10px 0 5px}
.stat-foot{font-size:10px;color:var(--green)}
.workspace{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:15px}
.section-title{font:700 16px 'Space Grotesk';margin:0 0 5px}
.section-desc{font-size:10px;color:var(--muted);margin:0 0 19px;line-height:1.6}
.field{margin-bottom:14px}
label{display:block;font-size:9px;letter-spacing:1px;font-weight:800;color:#c8c1de;margin-bottom:8px}
input,textarea,select{width:100%;padding:12px;background:#0a0913;border:1px solid #302a47;
border-radius:10px;color:white;outline:none;font-size:11px;transition:.2s}
input:focus,textarea:focus,select:focus{border-color:var(--purple);box-shadow:0 0 0 3px #a78bfa16}
textarea{min-height:83px;resize:vertical;line-height:1.6}
select option{background:#121126}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.primary{border:0;border-radius:10px;padding:13px;width:100%;color:white;font-weight:800;
font-size:11px;background:linear-gradient(110deg,#7651e8,#b45de0);
box-shadow:0 5px 25px #9b69ff30;transition:.2s}
.primary:hover{filter:brightness(1.16);transform:translateY(-2px)}
.secondary{border:1px solid #39304f;background:#211b36;color:#d9caff;border-radius:8px;
padding:7px 10px;font-size:10px;font-weight:700}
.result-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}
.badge{font-size:9px;padding:6px 9px;border:1px solid #554078;color:#c9aaff;
background:#211835;border-radius:20px}
.results{display:grid;gap:9px}
.result-item{background:#0b0a14;border:1px solid #29243b;padding:13px;border-radius:11px}
.result-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px}
.result-top strong{font-size:9px;letter-spacing:1.2px;color:#bba9ec}
.result-text{font-size:11px;line-height:1.75;color:#e3def1;white-space:pre-wrap;overflow-wrap:anywhere}
.empty{text-align:center;padding:45px 10px;color:var(--muted);font-size:11px;line-height:1.8}
.empty-icon{font-size:32px;color:var(--purple);margin-bottom:12px}
.notice{font-size:9px;color:var(--muted);line-height:1.6;margin:13px 0 0}
.history-list{display:grid;gap:9px}
.history-item{display:flex;justify-content:space-between;align-items:center;gap:12px}
.history-item strong{font-size:11px}
.history-item small{display:block;color:var(--muted);font-size:9px;margin-top:5px}
.toast{position:fixed;right:20px;bottom:20px;background:#211b36;border:1px solid var(--purple);
padding:12px 17px;border-radius:10px;font-size:11px;opacity:0;transform:translateY(10px);
transition:.2s;z-index:20}
.toast.show{opacity:1;transform:translateY(0)}
footer{text-align:center;color:#625d76;font-size:9px;margin-top:30px}
.about-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:20px}
.about-item{background:#0c0b17;border:1px solid var(--line);padding:17px;border-radius:12px}
.about-item strong{font-size:12px}.about-item p{font-size:10px;color:var(--muted);line-height:1.7}
@media(max-width:900px){.sidebar{width:205px}.main{margin-left:205px;width:calc(100% - 205px);padding:25px 19px}}
@media(max-width:650px){
.sidebar{position:relative;width:100%;height:auto;padding:14px;display:block;border:0;border-bottom:1px solid var(--line)}
.logo{font-size:21px}.tagline{margin:5px 0 12px}.nav-label,.sidebar-bottom{display:none}
.navs{display:flex;overflow-x:auto;gap:4px}.nav{width:auto;white-space:nowrap;padding:9px;font-size:10px;margin:0}
.main{margin:0;width:100%;padding:21px 13px}
.stats{gap:7px}.card{padding:13px}.stat-value{font-size:21px}
.workspace{grid-template-columns:1fr}.topbar{margin-bottom:22px}h1{font-size:25px}
}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
<div class="logo"><span class="logo-mark">✦</span>CLIP<span>FORGE</span></div>
<div class="tagline">YOUR CONTENT. YOUR GROWTH.</div>
<div class="nav-label">WORKSPACE</div>
<div class="navs">
<button class="nav active" data-page="studio"><span class="nav-icon">✧</span> Creator Studio</button>
<button class="nav" data-page="history"><span class="nav-icon">◷</span> History</button>
</div>
<div class="nav-label">DISCOVER</div>
<div class="navs">
<button class="nav" data-page="about"><span class="nav-icon">◈</span> About ClipForge</button>
</div>
<div class="sidebar-bottom">
<div class="status"><span class="dot"></span> SYSTEM ONLINE</div>
<p>Creator workspace V2. Your next idea starts here.</p>
</div>
</aside>
<main class="main">
<div class="topbar">
<div>
<div class="eyebrow">CLIPFORGE / CREATOR WORKSPACE</div>
<h1 id="pageTitle">Creator Studio</h1>
<div class="subtitle" id="pageSubtitle">Create better content. Build your audience.</div>
</div>
<div class="profile">CF</div>
</div>

<section class="page active" id="studio">
<div class="stats">
<div class="card"><div class="stat-label">CONTENT GENERATED</div><div class="stat-value" id="statCreated">0</div><div class="stat-foot">✦ Your creative activity</div></div>
<div class="card"><div class="stat-label">SAVED PACKS</div><div class="stat-value" id="statSaved">0</div><div class="stat-foot">◷ Stored locally</div></div>
<div class="card"><div class="stat-label">SUPPORTED PLATFORMS</div><div class="stat-value">03</div><div class="stat-foot">TikTok · Reels · Shorts</div></div>
</div>
<div class="workspace">
<div class="card">
<h2 class="section-title">Build your content</h2>
<p class="section-desc">Configure your video and generate a complete creator pack.</p>
<div class="field"><label for="topic">YOUR VIDEO IDEA</label><textarea id="topic" placeholder="Describe your video idea..."></textarea></div>
<div class="two">
<div class="field"><label for="platform">PLATFORM</label><select id="platform"><option>TikTok</option><option>Instagram Reels</option><option>YouTube Shorts</option></select></div>
<div class="field"><label for="duration">DURATION</label><select id="duration"><option value="15">15 seconds</option><option value="30" selected>30 seconds</option><option value="45">45 seconds</option><option value="60">60 seconds</option><option value="90">90 seconds</option></select></div>
</div>
<div class="two">
<div class="field"><label for="tone">CONTENT STYLE</label><select id="tone">
<option>Funny</option><option>Storytelling</option><option>Dramatic</option><option>Educational</option><option>Energetic</option><option>Professional</option><option>Mysterious</option><option>Motivational</option><option>Gaming</option><option>Documentary</option><option>Relaxed</option><option>Suspense</option><option>Commentary</option><option>Challenge</option><option>Review</option>
</select></div>
<div class="field"><label for="audience">AUDIENCE</label><select id="audience"><option>General audience</option><option>Gaming community</option><option>Young creators</option><option>Entertainment fans</option><option>Entrepreneurs</option><option>Sports fans</option><option>Technology fans</option></select></div>
</div>
<button class="primary" id="generate">✦ GENERATE CONTENT PACK</button>
<p class="notice">V2 uses built-in generation templates. No external AI service or paid API is connected.</p>
</div>
<div class="card">
<div class="result-head"><div><h2 class="section-title">Your content pack</h2><p class="section-desc" style="margin:5px 0 0">Your creative output appears here.</p></div><span class="badge">OUTPUT / 01</span></div>
<div id="results" class="empty"><div class="empty-icon">✧</div><strong>Ready to create?</strong><br>Your next video starts with one idea.</div>
</div>
</div>
</section>

<section class="page" id="history">
<div class="card">
<div class="result-head"><div><h2 class="section-title">Creation history</h2><p class="section-desc" style="margin:5px 0 0">Your previously generated content packs.</p></div><button class="secondary" id="clearHistory">Clear history</button></div>
<div id="historyList" class="history-list"></div>
</div>
</section>

<section class="page" id="about">
<div class="card">
<div class="eyebrow">THE CREATOR TOOLKIT</div>
<h2 style="font:700 27px 'Space Grotesk';margin:13px 0">Your Content. Your Growth.</h2>
<p class="subtitle" style="line-height:1.9">CLIPFORGE is a workspace built for short-form creators. Turn ideas into structured video concepts, scripts and publishing assets.</p>
<div class="about-grid">
<div class="about-item"><strong>✦ Content packs</strong><p>Hooks, scripts, titles, captions and hashtags.</p></div>
<div class="about-item"><strong>◈ Multi-platform</strong><p>Prepare content for TikTok, Reels and Shorts.</p></div>
<div class="about-item"><strong>◷ Local history</strong><p>Access your saved creations on this browser.</p></div>
<div class="about-item"><strong>⚡ Creator workflow</strong><p>Organize your content ideas in one workspace.</p></div>
</div>
<p class="notice">CLIPFORGE V2 · Template-based generation · Local browser storage.</p>
</div>
</section>
<footer>CLIPFORGE © 2026 · BUILT FOR CREATORS</footer>
</main>
</div>
<div class="toast" id="toast"></div>
<script>
const $=id=>document.getElementById(id);
let packs=[];
try{packs=JSON.parse(localStorage.getItem("cf_v2_packs")||"[]");if(!Array.isArray(packs))packs=[]}catch(e){packs=[]}
let total=Number(localStorage.getItem("cf_v2_total")||0);
function save(){localStorage.setItem("cf_v2_packs",JSON.stringify(packs));localStorage.setItem("cf_v2_total",String(total));stats()}
function stats(){$("statCreated").textContent=total;$("statSaved").textContent=packs.length}
function toast(msg){$("toast").textContent=msg;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1900)}
async function copyText(t){
try{await navigator.clipboard.writeText(t);toast("Copied successfully!")}
catch(e){let a=document.createElement("textarea");a.value=t;document.body.append(a);a.select();document.execCommand("copy");a.remove();toast("Copied!")}
}
function navigate(p){
document.querySelectorAll(".page").forEach(x=>x.classList.remove("active"));
document.querySelectorAll(".nav").forEach(x=>x.classList.remove("active"));
$(p).classList.add("active");
document.querySelectorAll(".nav").forEach(x=>{if(x.dataset.page===p)x.classList.add("active")});
let names={studio:["Creator Studio","Create better content. Build your audience."],history:["Creation History","Your previously generated content packs."],about:["About ClipForge","Discover your creator workspace."]};
$("pageTitle").textContent=names[p][0];$("pageSubtitle").textContent=names[p][1];
if(p==="history")renderHistory();
}
document.querySelectorAll(".nav").forEach(b=>b.addEventListener("click",()=>navigate(b.dataset.page)));

function generatePack(topic,platform,duration,tone,audience){
let hooks={
Funny:[`POV: You thought ${topic} was going to be easy...`,`Nobody expected THIS to happen with ${topic} 😂`,`I tried ${topic} and things got ridiculous...`],
Storytelling:[`It all started with ${topic}...`,`At first, everything seemed normal...`,`This is the story of ${topic}.`],
Dramatic:[`Everything changed because of ${topic}...`,`One moment changed everything.`,`The ending was not what anyone expected.`],
Educational:[`Here is what you need to know about ${topic}.`,`Three things you should understand about ${topic}.`,`Let's break down ${topic} in under a minute.`],
Energetic:[`LET'S GO! Today we're taking on ${topic}!`,`This is going to be INSANE!`,`Get ready, because ${topic} starts NOW!`],
Professional:[`A closer look at ${topic}.`,`Let's explore what makes ${topic} interesting.`,`Here is a simple breakdown of ${topic}.`],
Mysterious:[`Something about ${topic} doesn't add up...`,`There is more to this story than you think.`,`The detail everyone missed...`],
Motivational:[`Every big result starts with one small step.`,`What if you finally gave ${topic} a chance?`,`Keep going. Your progress matters.`],
Gaming:[`I tested ${topic} in-game and this happened...`,`This gaming moment was unreal!`,`Can we actually beat ${topic}?`],
Documentary:[`The story behind ${topic}.`,`Let's take a closer look at this subject.`,`What really happened with ${topic}?`],
Relaxed:[`Let's talk about ${topic}.`,`A little look into ${topic}.`,`Here's something interesting to explore.`],
Suspense:[`Wait until you see the final moment...`,`It was all going well until THIS happened.`,`Nobody saw that coming.`],
Commentary:[`We need to talk about ${topic}.`,`Here's my take on this situation.`,`Let's discuss what happened.`],
Challenge:[`Can I complete ${topic}?`,`I gave myself one challenge...`,`The rules are simple. The result isn't.`],
Review:[`Is ${topic} actually worth it?`,`Let's review ${topic}.`,`My honest breakdown of ${topic}.`]
};
let arr=hooks[tone]||hooks.Funny;
let hook=arr[Math.floor(Math.random()*arr.length)];
let script=`[0–3 SEC] THE HOOK\n${hook}\n\n[3–${Math.max(7,Math.round(duration*.25))} SEC] SETUP\nIntroduce ${topic}. Give viewers the context they need and show why they should keep watching.\n\n[${Math.max(7,Math.round(duration*.25))}–${Math.round(duration*.8)} SEC] MAIN CONTENT\nBuild the story step by step. Show the most interesting moments, add details, and keep the pace engaging.\n\n[FINAL SECONDS] PAYOFF + CTA\nDeliver the main result or reveal. Finish with a natural question that invites viewers to comment.`;
let titles=[`${topic.toUpperCase()} — YOU NEED TO SEE THIS`,`I WAS NOT EXPECTING THIS...`,`THE TRUTH ABOUT ${topic.toUpperCase()}`,`THIS CHANGED EVERYTHING 👀`,`WAIT FOR THE END!`];
let desc={
Funny:`Things got out of control 😂 What would you have done? Follow for more.`,
Storytelling:`Every story has a twist. Watch until the end and tell me what you think.`,
Dramatic:`You won't expect what happens next. Stay until the end.`,
Educational:`A quick breakdown of ${topic}. Save this and share your thoughts.`,
Energetic:`That was INSANE! More content coming soon ⚡`,
Professional:`Exploring ${topic}. Share your thoughts in the comments.`,
Mysterious:`There is always more to the story. What do you think happened?`,
Motivational:`Small steps create big progress. Keep moving forward.`,
Gaming:`Gaming moments, unexpected twists and more. Follow for the next one!`,
Documentary:`A closer look at ${topic}. What should we explore next?`,
Relaxed:`Thanks for watching. Let me know what you think.`,
Suspense:`Did you see that coming? Tell me your theory below.`,
Commentary:`What's your opinion? Let's discuss it in the comments.`,
Challenge:`Would you take on this challenge? Let me know below.`,
Review:`Have you tried it? Share your experience in the comments.`
};
let tags=["#fyp","#viral","#creator","#content","#trending"];
if(platform==="TikTok")tags.push("#tiktok");
if(platform==="Instagram Reels")tags.push("#reels","#instagram");
if(platform==="YouTube Shorts")tags.push("#shorts","#youtubeshorts");
if(tone==="Gaming")tags.push("#gaming","#gamer");
if(tone==="Funny")tags.push("#funny","#comedy");
if(tone==="Educational")tags.push("#learn","#tips");
let words=topic.toLowerCase().replace(/[^a-z0-9À-ÿ ]/g,"").split(/\s+/).filter(x=>x.length>2).slice(0,3);
words.forEach(w=>tags.push("#"+w));
return {id:Date.now(),topic,platform,duration,tone,audience,hook,script,title:titles[Math.floor(Math.random()*titles.length)],description:desc[tone]||desc.Funny,hashtags:[...new Set(tags)].join(" ")};
}
function renderResults(p){
let entries=[["HOOK",p.hook],["VIDEO TITLE",p.title],["SCRIPT",p.script],["DESCRIPTION",p.description],["HASHTAGS",p.hashtags]];
let root=$("results");root.className="results";root.innerHTML="";
entries.forEach(([name,value])=>{
let box=document.createElement("div");box.className="result-item";
let top=document.createElement("div");top.className="result-top";
let strong=document.createElement("strong");strong.textContent=name;
let btn=document.createElement("button");btn.className="secondary";btn.textContent="COPY";btn.addEventListener("click",()=>copyText(value));
top.append(strong,btn);
let text=document.createElement("div");text.className="result-text";text.textContent=value;
box.append(top,text);root.append(box);
});
}
function renderHistory(){
let root=$("historyList");root.innerHTML="";
if(!packs.length){root.innerHTML='<div class="empty">✧<br>No creations yet. Your content packs will appear here.</div>';return}
packs.forEach(p=>{
let box=document.createElement("div");box.className="result-item history-item";
let info=document.createElement("div");let strong=document.createElement("strong");strong.textContent=p.topic;
let small=document.createElement("small");small.textContent=p.platform+" · "+p.duration+" seconds · "+p.tone;
info.append(strong,small);
let btn=document.createElement("button");btn.className="secondary";btn.textContent="VIEW";
btn.addEventListener("click",()=>{navigate("studio");renderResults(p)});
box.append(info,btn);root.append(box);
});
}
$("generate").addEventListener("click",()=>{
let topic=$("topic").value.trim();
if(topic.length<3){toast("Please enter a video idea.");$("topic").focus();return}
let p=generatePack(topic,$("platform").value,$("duration").value,$("tone").value,$("audience").value);
renderResults(p);packs.unshift(p);packs=packs.slice(0,40);total++;save();toast("Your content pack is ready!");
});
$("clearHistory").addEventListener("click",()=>{
if(!packs.length){toast("Your history is already empty.");return}
if(confirm("Delete all saved creations?")){packs=[];save();renderHistory();toast("History cleared.")}
});
stats();
</script>
</body>
</html>