
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090816">
<title>CLIPFORGE — Creator Studio</title>
<style>
:root{
  --bg:#090816;
  --panel:#121126;
  --panel2:#191733;
  --line:#292548;
  --purple:#9b75ff;
  --pink:#e879f9;
  --text:#f6f3ff;
  --muted:#a5a0bf;
  --green:#67e8b1;
}
*{box-sizing:border-box}
body{
 margin:0;background:var(--bg);color:var(--text);
 font-family:Inter,system-ui,Arial,sans-serif;
}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.app{display:flex;min-height:100vh}
.sidebar{
 width:245px;background:#0d0b1c;border-right:1px solid var(--line);
 padding:25px 17px;position:fixed;inset:0 auto 0 0;
 display:flex;flex-direction:column;z-index:5;
}
.logo{font-size:24px;font-weight:900;letter-spacing:-1px;margin-bottom:5px}
.logo span{color:var(--purple)}
.tagline{font-size:11px;color:var(--muted);margin-bottom:38px}
.nav-label{font-size:10px;color:#77718f;font-weight:800;letter-spacing:1.5px;margin:15px 10px}
.nav{
 width:100%;border:0;background:transparent;color:var(--muted);
 padding:12px;border-radius:11px;text-align:left;margin:3px 0;
 display:flex;gap:12px;align-items:center;font-size:13px;
}
.nav.active,.nav:hover{background:#211b3b;color:white}
.nav.active{box-shadow:inset 3px 0 var(--purple)}
.sidebar-bottom{margin-top:auto;background:var(--panel);border:1px solid var(--line);padding:14px;border-radius:14px}
.sidebar-bottom strong{font-size:12px}
.sidebar-bottom p{font-size:11px;color:var(--muted);line-height:1.5}
.main{margin-left:245px;width:calc(100% - 245px);padding:30px 38px 60px}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:32px;gap:15px}
.eyebrow{font-size:11px;color:var(--purple);font-weight:800;letter-spacing:1.5px}
h1{font-size:30px;letter-spacing:-1.3px;margin:7px 0}
.subtitle{color:var(--muted);font-size:13px}
.avatar{width:40px;height:40px;border-radius:13px;background:linear-gradient(135deg,#9b75ff,#e879f9);display:grid;place-items:center;font-weight:900}
.page{display:none}.page.active{display:block}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-bottom:24px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:19px}
.stat-title{font-size:11px;color:var(--muted)}
.stat-value{font-size:26px;font-weight:850;margin:9px 0 4px}
.stat-note{font-size:10px;color:var(--green)}
.workspace{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr);gap:18px}
.section-title{font-size:16px;font-weight:800;margin:0 0 5px}
.section-desc{font-size:11px;color:var(--muted);margin:0 0 20px}
.field{margin-bottom:16px}
label{display:block;font-size:11px;font-weight:700;color:#d4cfee;margin-bottom:8px}
input,textarea,select{
 width:100%;background:#0d0b1c;border:1px solid var(--line);
 color:white;border-radius:10px;padding:12px;outline:none;
}
input:focus,textarea:focus,select:focus{border-color:var(--purple)}
textarea{resize:vertical;min-height:85px}
select option{background:#121126}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.primary{
 border:0;border-radius:11px;padding:13px 17px;
 color:white;font-weight:800;background:linear-gradient(110deg,#8158ee,#bd69e8);
 width:100%;transition:.2s;
}
.primary:hover{filter:brightness(1.15);transform:translateY(-1px)}
.secondary{
 border:1px solid var(--line);border-radius:9px;padding:8px 11px;
 color:#ddd5ff;background:#211b3b;font-size:11px;font-weight:700;
}
.result-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}
.result-list{display:grid;gap:11px}
.result-item{background:#0d0b1c;border:1px solid var(--line);border-radius:12px;padding:14px}
.result-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.result-top strong{font-size:12px}
.result-text{font-size:12px;line-height:1.7;color:#d7d1ed;white-space:pre-wrap;overflow-wrap:anywhere}
.empty{padding:45px 15px;text-align:center;color:var(--muted);font-size:12px;line-height:1.8}
.empty-icon{font-size:32px;margin-bottom:12px}
.history-list{display:grid;gap:10px}
.history-item{display:flex;align-items:center;justify-content:space-between;gap:12px}
.history-item strong{font-size:12px}
.history-item small{display:block;color:var(--muted);font-size:10px;margin-top:5px}
.badge{background:#292044;color:#cbb7ff;padding:5px 8px;border-radius:7px;font-size:10px}
.notice{color:var(--muted);font-size:10px;line-height:1.6;margin-top:15px}
.toast{
 position:fixed;bottom:22px;right:22px;background:#211b3b;
 border:1px solid var(--purple);padding:13px 18px;border-radius:11px;
 font-size:12px;opacity:0;transform:translateY(10px);transition:.25s;z-index:20;
}
.toast.show{opacity:1;transform:translateY(0)}
.mobile-menu{display:none}
footer{color:#77718f;font-size:10px;margin-top:35px;text-align:center}
@media(max-width:850px){
 .sidebar{width:205px}.main{margin-left:205px;width:calc(100% - 205px);padding:25px 20px}
 .workspace{grid-template-columns:1fr}
}
@media(max-width:620px){
 .sidebar{position:relative;width:100%;height:auto;padding:14px;display:block;border-right:0;border-bottom:1px solid var(--line)}
 .logo{font-size:21px}.tagline{margin-bottom:12px}
 .sidebar .nav-label,.sidebar-bottom{display:none}
 .navs{display:flex;gap:5px;overflow-x:auto}
 .nav{white-space:nowrap;width:auto;margin:0;padding:9px;font-size:11px}
 .main{margin:0;width:100%;padding:22px 14px}
 .stats{gap:8px}.card{padding:13px}
 .stat-value{font-size:20px}
 h1{font-size:25px}
 .topbar{margin-bottom:23px}
}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
  <div class="logo">CLIP<span>FORGE</span></div>
  <div class="tagline">YOUR CONTENT. YOUR GROWTH.</div>
  <div class="nav-label">WORKSPACE</div>
  <div class="navs">
    <button class="nav active" data-page="studio">✦ Creator Studio</button>
    <button class="nav" data-page="history">◷ History</button>
  </div>
  <div class="nav-label">INFORMATION</div>
  <div class="navs">
    <button class="nav" data-page="about">◈ About ClipForge</button>
  </div>
  <div class="sidebar-bottom">
    <strong>⚡ CLIPFORGE V1</strong>
    <p>Your content creation workspace. Create ideas, scripts and captions in seconds.</p>
  </div>
</aside>

<main class="main">
  <div class="topbar">
    <div>
      <div class="eyebrow">CREATOR WORKSPACE / 001</div>
      <h1 id="pageTitle">Creator Studio</h1>
      <div class="subtitle" id="pageSubtitle">Turn your ideas into content that gets noticed.</div>
    </div>
    <div class="avatar">CF</div>
  </div>

  <section class="page active" id="studio">
    <div class="stats">
      <div class="card">
        <div class="stat-title">CONTENT PACKS CREATED</div>
        <div class="stat-value" id="statCreated">0</div>
        <div class="stat-note">Your creative activity</div>
      </div>
      <div class="card">
        <div class="stat-title">SAVED PACKS</div>
        <div class="stat-value" id="statSaved">0</div>
        <div class="stat-note">Stored on this device</div>
      </div>
      <div class="card">
        <div class="stat-title">PLATFORMS</div>
        <div class="stat-value">03</div>
        <div class="stat-note">TikTok · Reels · Shorts</div>
      </div>
    </div>

    <div class="workspace">
      <div class="card">
        <h2 class="section-title">Create your content pack</h2>
        <p class="section-desc">Give us your idea. Build your next video concept.</p>
        <div class="field">
          <label for="topic">VIDEO TOPIC / IDEA</label>
          <textarea id="topic" placeholder="Example: A funny Roblox game where everything goes wrong..."></textarea>
        </div>
        <div class="two">
          <div class="field">
            <label for="platform">PLATFORM</label>
            <select id="platform">
              <option value="TikTok">TikTok</option>
              <option value="Instagram Reels">Instagram Reels</option>
              <option value="YouTube Shorts">YouTube Shorts</option>
            </select>
          </div>
          <div class="field">
            <label for="duration">VIDEO DURATION</label>
            <select id="duration">
              <option value="15 seconds">15 seconds</option>
              <option value="30 seconds" selected>30 seconds</option>
              <option value="45 seconds">45 seconds</option>
              <option value="60 seconds">60 seconds</option>
              <option value="90 seconds">90 seconds</option>
            </select>
          </div>
        </div>
        <div class="two">
          <div class="field">
            <label for="tone">CONTENT TONE</label>
            <select id="tone">
              <option value="Funny">Funny</option>
              <option value="Dramatic">Dramatic</option>
              <option value="Energetic">Energetic</option>
              <option value="Educational">Educational</option>
              <option value="Storytelling">Storytelling</option>
              <option value="Professional">Professional</option>
            </select>
          </div>
          <div class="field">
            <label for="audience">TARGET AUDIENCE</label>
            <select id="audience">
              <option>General audience</option>
              <option>Gaming community</option>
              <option>Young creators</option>
              <option>Entertainment fans</option>
              <option>Entrepreneurs</option>
            </select>
          </div>
        </div>
        <button class="primary" id="generate">✦ Generate content pack</button>
        <p class="notice">This version uses built-in creative templates. No external AI service is connected yet.</p>
      </div>

      <div class="card">
        <div class="result-head">
          <div>
            <h2 class="section-title">Your content pack</h2>
            <p class="section-desc" style="margin:5px 0 0">Your generated results appear here.</p>
          </div>
          <span class="badge">OUTPUT</span>
        </div>
        <div id="results" class="empty">
          <div class="empty-icon">✧</div>
          <strong>Your next video starts here.</strong><br>
          Enter a topic and generate your first content pack.
        </div>
      </div>
    </div>
  </section>

  <section class="page" id="history">
    <div class="card">
      <div class="result-head">
        <div>
          <h2 class="section-title">Your history</h2>
          <p class="section-desc" style="margin:5px 0 0">Your previously generated content packs.</p>
        </div>
        <button class="secondary" id="clearHistory">Clear history</button>
      </div>
      <div id="historyList" class="history-list"></div>
    </div>
  </section>

  <section class="page" id="about">
    <div class="card">
      <div class="eyebrow">THE CREATOR TOOLKIT</div>
      <h2 style="font-size:25px;margin:12px 0">Your Content. Your Growth.</h2>
      <p class="subtitle" style="line-height:1.9">CLIPFORGE is a content creation workspace designed for short-form creators. Organize your ideas, create video concepts, and prepare your next post for TikTok, Instagram Reels and YouTube Shorts.</p>
      <div class="result-list" style="margin-top:25px">
        <div class="result-item"><strong>✦ Content generation</strong><p class="subtitle">Hooks, scripts, titles, descriptions and hashtags.</p></div>
        <div class="result-item"><strong>◷ Local history</strong><p class="subtitle">Keep track of the packs you create on this device.</p></div>
        <div class="result-item"><strong>⚡ Multi-platform</strong><p class="subtitle">Prepare content for three major short-form platforms.</p></div>
      </div>
      <p class="notice">CLIPFORGE V1 · Template-based generator · Your history is stored locally in your browser.</p>
    </div>
  </section>
  <footer>CLIPFORGE © 2026 · YOUR CONTENT. YOUR GROWTH.</footer>
</main>
</div>
<div class="toast" id="toast">Copied!</div>

<script>
const $ = id => document.getElementById(id);
let historyData = [];
try {
  historyData = JSON.parse(localStorage.getItem("clipforge_history") || "[]");
  if (!Array.isArray(historyData)) historyData = [];
} catch(e) { historyData = []; }

let totalCreated = Number(localStorage.getItem("clipforge_created") || 0);

function saveData(){
  localStorage.setItem("clipforge_history",JSON.stringify(historyData));
  localStorage.setItem("clipforge_created",String(totalCreated));
  updateStats();
}
function updateStats(){
  $("statCreated").textContent=totalCreated;
  $("statSaved").textContent=historyData.length;
}
function toast(message){
  $("toast").textContent=message;
  $("toast").classList.add("show");
  setTimeout(()=>$("toast").classList.remove("show"),1800);
}
async function copyText(text){
  try{
    await navigator.clipboard.writeText(text);
    toast("Copied to clipboard!");
  }catch(e){
    const area=document.createElement("textarea");
    area.value=text;document.body.appendChild(area);
    area.select();document.execCommand("copy");area.remove();
    toast("Copied!");
  }
}
function showPage(page){
  document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
  document.querySelectorAll(".nav").forEach(n=>n.classList.remove("active"));
  $(page).classList.add("active");
  document.querySelectorAll(".nav").forEach(n=>{
    if(n.dataset.page===page)n.classList.add("active");
  });
  const names={
    studio:["Creator Studio","Turn your ideas into content that gets noticed."],
    history:["Your History","Your saved content packs."],
    about:["About CLIPFORGE","Discover your creator workspace."]
  };
  $("pageTitle").textContent=names[page][0];
  $("pageSubtitle").textContent=names[page][1];
  if(page==="history")renderHistory();
}
document.querySelectorAll(".nav").forEach(n=>{
  n.addEventListener("click",()=>showPage(n.dataset.page));
});

function makePack(topic,platform,duration,tone,audience){
  const clean=topic.trim().replace(/[.!?]+$/,"");
  const hooks={
    Funny:[
      `POV: You thought "${clean}" was going to be easy...`,
      `Nobody warned me about "${clean}" 😂`,
      `This is what happens when "${clean}" goes completely wrong...`
    ],
    Dramatic:[
      `Everything changed when "${clean}" happened...`,
      `I never expected this ending...`,
      `One moment. One decision. Everything changed.`
    ],
    Energetic:[
      `LET'S GO! Today we're taking on "${clean}"!`,
      `You need to see what happens next!`,
      `This might be the craziest challenge yet!`
    ],
    Educational:[
      `Here's something you should know about "${clean}"...`,
      `3 things to understand before trying this.`,
      `Let me explain why this matters.`
    ],
    Storytelling:[
      `It all started with "${clean}"...`,
      `At first, everything seemed normal...`,
      `This story took a turn I didn't expect.`
    ],
    Professional:[
      `Let's break down "${clean}" in a simple way.`,
      `Here's what you need to know.`,
      `A closer look at an interesting idea.`
    ]
  };
  const chosen=hooks[tone]||hooks.Funny;
  const hook=chosen[Math.floor(Math.random()*chosen.length)];
  const script=`[0–3 SEC] HOOK\n${hook}\n\n[3–10 SEC] SETUP\nIntroduce the idea: ${clean}. Give viewers a reason to keep watching.\n\n[10–${duration}] MAIN CONTENT\nShow the most interesting moments, explain what is happening, and build toward the best part. Keep the pace moving.\n\n[FINAL MOMENT] PAYOFF + CTA\nDeliver a satisfying ending and invite viewers to comment their opinion or follow for more.`;
  const titleOptions=[
    `${clean}... WHAT HAPPENED?!`,
    `You need to see this 👀`,
    `The truth about ${clean}`,
    `I wasn't ready for this 😂`
  ];
  const title=titleOptions[Math.floor(Math.random()*titleOptions.length)];
  const descriptions={
    Funny:`Things got out of control 😂 What would you have done?`,
    Dramatic:`You won't expect what happens next. Stay until the end.`,
    Energetic:`That was INSANE! More content coming soon ⚡`,
    Educational:`A quick breakdown of ${clean}. What do you think?`,
    Storytelling:`Every story has a twist. Here's mine.`,
    Professional:`Exploring ${clean}. Share your thoughts in the comments.`
  };
  const tags=["#fyp","#viral","#contentcreator","#shorts","#trending"];
  const extra=clean.toLowerCase().replace(/[^a-z0-9À-ÿ ]/g,"").split(/\s+/).filter(Boolean).slice(0,2);
  extra.forEach(w=>tags.push("#"+w));
  if(platform==="TikTok")tags.push("#tiktok");
  if(platform==="Instagram Reels")tags.push("#reels");
  if(platform==="YouTube Shorts")tags.push("#youtubeshorts");
  return {
    id:Date.now(),
    topic:clean,platform,duration,tone,audience,
    hook,script,title,
    description:descriptions[tone]||descriptions.Funny,
    hashtags:[...new Set(tags)].join(" ")
  };
}
function renderResults(pack){
  const items=[
    ["HOOK",pack.hook],
    ["VIDEO TITLE",pack.title],
    ["VIDEO SCRIPT",pack.script],
    ["DESCRIPTION",pack.description],
    ["HASHTAGS",pack.hashtags]
  ];
  $("results").className="result-list";
  $("results").innerHTML="";
  items.forEach(([name,value])=>{
    const item=document.createElement("div");
    item.className="result-item";
    const top=document.createElement("div");
    top.className="result-top";
    const strong=document.createElement("strong");
    strong.textContent=name;
    const btn=document.createElement("button");
    btn.className="secondary";
    btn.textContent="Copy";
    btn.addEventListener("click",()=>copyText(value));
    top.append(strong,btn);
    const text=document.createElement("div");
    text.className="result-text";
    text.textContent=value;
    item.append(top,text);
    $("results").appendChild(item);
  });
}
function renderHistory(){
  const list=$("historyList");
  list.innerHTML="";
  if(!historyData.length){
    list.innerHTML='<div class="empty"><div class="empty-icon">◷</div>No saved content packs yet.</div>';
    return;
  }
  historyData.forEach(pack=>{
    const item=document.createElement("div");
    item.className="result-item history-item";
    const info=document.createElement("div");
    const title=document.createElement("strong");
    title.textContent=pack.topic;
    const small=document.createElement("small");
    small.textContent=pack.platform+" · "+pack.duration+" · "+pack.tone;
    info.append(title,small);
    const btn=document.createElement("button");
    btn.className="secondary";
    btn.textContent="View";
    btn.addEventListener("click",()=>{
      showPage("studio");
      renderResults(pack);
    });
    item.append(info,btn);
    list.appendChild(item);
  });
}
$("generate").addEventListener("click",()=>{
  const topic=$("topic").value.trim();
  if(topic.length<3){
    toast("Enter a topic first!");
    $("topic").focus();
    return;
  }
  const pack=makePack(topic,$("platform").value,$("duration").value,$("tone").value,$("audience").value);
  renderResults(pack);
  historyData.unshift(pack);
  historyData=historyData.slice(0,50);
  totalCreated++;
  saveData();
  toast("Content pack created!");
});
$("clearHistory").addEventListener("click",()=>{
  if(!historyData.length){toast("History is already empty.");return;}
  if(confirm("Delete all saved content packs?")){
    historyData=[];
    saveData();
    renderHistory();
    toast("History cleared.");
  }
});
updateStats();
</script>
</body>
</html>
